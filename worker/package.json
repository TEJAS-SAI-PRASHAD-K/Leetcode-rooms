{
  "name": "@lcr/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply leetcode-rooms --local",
    "migrate:remote": "wrangler d1 migrations apply leetcode-rooms --remote",
