    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lcr/shared": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "vitest": "^5.0.5",
    "wrangler": "^3.99.0"
  }
}
